#include<stdio.h>
int main()
{
int n,original,digit,sum=0;
printf("Enter n=");
scanf("%d",&n);
original=n;
while(n!=0)
{
digit=n%10;
sum=sum+(digit*digit*digit);
n=n/10;
}
if(sum==original)
{
printf("%d is Armstrong number",original);
}
else
{
printf("%d is Not Armstrong number",original); 
}
return 0;
}